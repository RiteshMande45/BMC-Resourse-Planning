# ── Server ────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development

# ── PostgreSQL ─────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/bmc_resource_planning

# ── Auth (JWT) ─────────────────────────────
JWT_SECRET=change_me_before_production
JWT_EXPIRES_IN=7d

# ── Google Sheets  ──────────────────────────
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_SHEET_ID=
